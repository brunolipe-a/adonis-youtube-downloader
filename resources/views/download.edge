<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Download Playlist</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css">
</head>

<body>
  <div class="container mt-5">
    <!-- Alert de sucesso -->
    @if (isOk)
    <div class="alert alert-success" role="alert">
      Download da playlist realizado com sucesso!
    </div>
    @endif

    <h1 class="mb-4">Download de Playlist</h1>

    <!-- Formulário para informar a URL da playlist -->
    <form action="/playlist/download" method="POST" class="mb-4">
      <div class="mb-3">
        <label for="playlistUrl" class="form-label">URL da Playlist</label>
        <input type="text" id="playlistUrl" name="playlistUrl" class="form-control"
          placeholder="Informe a URL da playlist" required>
      </div>
      <button type="submit" class="btn btn-primary">Iniciar Download</button>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
