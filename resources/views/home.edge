<!DOCTYPE html>
<html>

<head>
  <title>Gerenciador de Pastas e Músicas</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
</head>

<body class="bg-light">
  <div class="container mt-5">
    <h1 class="text-center mb-4">Gerenciador de Pastas e Músicas</h1>

    <!-- Criar nova pasta -->
    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title">Criar Nova Pasta</h5>
        <form method="POST" action="/folders">
          <div class="mb-3">
            <input type="text" name="name" class="form-control" placeholder="Nome da pasta" required>
          </div>
          <button type="submit" class="btn btn-primary">Criar Pasta</button>
        </form>
      </div>
    </div>

    <!-- Listagem de pastas -->
    @each(folder in folders)
    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title">{{ folder.name }}</h5>
        <div>
          <!-- Botão de download -->
          <form method="POST" action="/folders/{{ folder.id }}/download" class="d-inline">
            <button type="submit" class="btn btn-sm btn-secondary">Download</button>
          </form>
          <!-- Botão de deletar -->
          <form method="POST" action="/folders/{{ folder.id }}?_method=DELETE" class="d-inline">
            <button type="submit" class="btn btn-sm btn-danger"
              onclick="return confirm('Tem certeza que deseja deletar esta pasta?')">Deletar</button>
          </form>
        </div>




        <!-- Listagem de músicas -->
        <ul class="list-group mb-3">
          @each(music in folder.musics)
          <li class="list-group-item d-flex justify-content-between align-items-center">
            {{ music.title }}
            <form method="POST" action="/musics/{{ music.id }}?_method=DELETE" class="d-inline">
              <button type="submit" class="btn btn-sm btn-danger"
                onclick="return confirm('Tem certeza que deseja deletar esta musica?')">Deletar</button>
            </form>
            {{--  <a href="{{ music.link }}" class="btn btn-sm btn-outline-secondary" target="_blank">Ouvir</a> --}}
          </li>
          @endeach
        </ul>


        <!-- Adicionar link do YouTube -->
        <form method="POST" action="/folders/{{ folder.id }}/playlists">
          <div class="input-group">
            <input type="text" name="playlistUrl" class="form-control" placeholder="Link do YouTube" required>
            <button type="submit" class="btn btn-success">Adicionar Música</button>
          </div>
        </form>
      </div>
    </div>
    @endeach


  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
